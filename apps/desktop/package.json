{
  "name": "@agent-autopsy/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "bundle:backend": "node scripts/bundle-backend.mjs",
    "build": "tsc && vite build && node scripts/bundle-backend.mjs",
    "preview": "vite preview",
    "start": "electron .",
    "pack:exe": "pnpm run build && electron-builder --win --dir",
    "dist:exe": "pnpm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.agentautopsy.app",
    "productName": "AgentAutopsy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "electron/bundled/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/bundled",
        "to": "bundled",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "dir",
        "portable"
      ]
    }
  },
  "dependencies": {
    "@agent-autopsy/core": "workspace:*",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.0",
    "vite": "^6.1.0"
  }
}
