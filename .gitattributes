# Store and check out text files with LF line endings
* text=auto eol=lf

# Always treat source files as text (Git's binary heuristic can misfire)
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf

# Windows-only scripts keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wasm binary
*.exe binary
*.dll binary
*.node binary
*.db binary
*.sqlite binary
*.woff binary
*.woff2 binary
*.zip binary
